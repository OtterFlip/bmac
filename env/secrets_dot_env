# Copy this example file to env/secrets.env (put the copy in the same directory), fill it in, and run:
#   chmod 600 env/secrets.env
# secrets.env is Git-ignored and is the only private configuration file used
# by these orchestration scripts.

# Optional. These are required only when setup_proxmox_host.sh is run in
# iDRAC/Redfish inventory mode. Manual Live Linux inventory does not use them.
IDRAC_USER=redacted
IDRAC_PASSWORD=redacted

# All Proxmox hosts share the same root console password.
PROXMOX_ROOT_PASSWORD=redacted

# Production guests share this console password. SSH remains key-only.
PROD_GUEST_VM_ROOT_PASSWORD=redacted

# Staging guests share this console password. SSH remains key-only.
STAGING_GUEST_VM_ROOT_PASSWORD=redacted

# All of our Proxmox hosts use the same LUKS password for all of their encrypted disks
PROXMOX_LUKS_PASSWORD=redacted

# Our qdevice has its own root password
PROXMOX_QDEVICE_ROOT_PASSWORD=redacted
