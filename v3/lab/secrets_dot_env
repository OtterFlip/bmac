# Copy this example file to lab/secrets.env (in the same directory), fill it
# in, and run:
#   chmod 600 lab/secrets.env
# secrets.env is Git-ignored. Only the lab reads it, and only in-process: the
# values are never printed or written to the lab's logs.

# The key name and value must be separated by an '=' character with no
# additional space. If the value contains spaces, enclose it in single quotes:
#   VALID_SYNTAX_EXAMPLE='This key value pair has valid syntax'
#   INVALID_SYNTAX_EXAMPLE = This key value pair has invalid syntax

# Tailscale auth keys for lab VMs (README.md, "Tailscale for the lab"), all
# from the lab's own Tailscale account, never the production one. Make each
# one Reusable, with Tags on and only the tag named. Auth keys expire
# after at most 90 days; when the lab reports a key was refused, make a new
# one and replace it here.

# Tagged tag:bmac-proxmox-host. Not ephemeral.
TAILSCALE_LAB_AUTH_KEY_PROXMOX_HOST=

# Tagged tag:bmac-proxmox-qdevice. Not ephemeral.
TAILSCALE_LAB_AUTH_KEY_QDEVICE=

# Tagged tag:bmac-backup-appliance. Not ephemeral.
TAILSCALE_LAB_AUTH_KEY_BACKUP_APPLIANCE=

# Tagged tag:bmac-discovery. Ephemeral.
TAILSCALE_LAB_AUTH_KEY_DISCOVERY=

# Tailscale API access token. The lab uses it only to list and remove its own
# devices (named bmaclab-, tagged only with the tags above). It expires too; replace it
# when the lab reports it was refused.
TAILSCALE_LAB_API_KEY=

# This is the email address of the admin/owner of the account that should be used for lab executions
# Lab tests should first use the TAILSCALE_LAB_API_KEY value to query the current policy and check the email
# address of the admin/owner, and if it doesn't match this value then lab tests must not run becasue this
# means that the workstation may be logged into Tailscale on the production Tailscale account
TAILSCALE_LAB_ADMIN_EMAIL=

# Server API token of the lab's Postmark server (README.md, "Email for the
# lab"). Make that server's delivery type Sandbox: Postmark accepts its email
# and delivers none. Its messages still count toward the account's monthly
# volume, so send few.
POSTMARKAPP_LAB_API_KEY=

# This is the authorized email-from value for your postmarkapp.com account (ex: noreply@example.com)
POSTMARKAPP_LAB_API_SENDER_SIGNATURE=
