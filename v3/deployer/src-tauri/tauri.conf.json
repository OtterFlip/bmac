{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BMAC_Deployer",
  "mainBinaryName": "bmac-deployer",
  "identifier": "com.btvcorp.bmac.deployer",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "BMAC Deployer",
        "width": 1380,
        "height": 900,
        "minWidth": 1040,
        "minHeight": 680,
        "backgroundColor": "#0a0c10"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb"],
    "category": "DeveloperTool",
    "shortDescription": "Installs BMAC Proxmox hosts and backup appliances",
    "icon": ["icons/128x128@2x.png", "icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "homepage": "https://github.com/OtterFlip/bmac",
    "linux": {
      "deb": {
        "depends": ["openssh-client", "xorriso", "dpkg"],
        "recommends": ["tailscale"],
        "desktopTemplate": "linux/bmac-deployer.desktop"
      }
    }
  }
}
