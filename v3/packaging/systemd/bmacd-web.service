[Unit]
Description=BMAC HTTPS front end
Documentation=file:///usr/share/doc/bmacd/README.md
BindsTo=bmacd.service
PartOf=bmacd.service
After=bmacd.service

[Service]
Type=notify
ExecStart=/usr/lib/bmac/bmacd web
User=bmac-web
Group=bmac-web
LoadCredential=https.key:/etc/bmac/tls/https.key
LoadCredential=https.pem:/etc/bmac/tls/https.pem
Restart=on-failure
RestartSec=2s
UMask=0077

NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
InaccessiblePaths=-/etc/pve -/etc/bmac -/var/lib/bmac -/root
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM
