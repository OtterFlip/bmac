{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BMAC Dashboard",
  "version": "1.1.0",
  "identifier": "com.beentherevc.bmac.dashboard",
  "build": {
    "beforeDevCommand": "pnpm web:dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm web:build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "BMAC Dashboard",
        "width": 1480,
        "height": 940,
        "minWidth": 1120,
        "minHeight": 720,
        "backgroundColor": "#0a0c10"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Control panel for BMAC Proxmox clusters",
    "icon": [
      "icons/128x128@2x.png",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
