{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BMAC_Dashboard",
  "mainBinaryName": "bmac-dashboard",
  "identifier": "com.btvcorp.bmac.dashboard",
  "build": {
    "beforeDevCommand": "pnpm web:dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm web:build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "BMAC Dashboard",
        "width": 1480,
        "height": 940,
        "minWidth": 1120,
        "minHeight": 720,
        "backgroundColor": "#0a0c10"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Control panel for BMAC Proxmox clusters",
    "icon": [
      "icons/128x128@2x.png",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "bundle-resources/": ""
    },
    "homepage": "https://github.com/OtterFlip/bmac",
    "linux": {
      "deb": {
        "depends": [
          "bash (>= 4.4)",
          "python3 (>= 3.9)",
          "openssh-client",
          "openssl",
          "curl",
          "jq",
          "util-linux",
          "iproute2",
          "coreutils",
          "tar"
        ],
        "recommends": [
          "git",
          "xorriso"
        ],
        "desktopTemplate": "linux/bmac-dashboard.desktop"
      },
      "rpm": {
        "depends": [
          "bash >= 4.4",
          "python3 >= 3.9",
          "openssh-clients",
          "openssl",
          "curl",
          "jq",
          "util-linux",
          "iproute",
          "coreutils",
          "tar"
        ],
        "desktopTemplate": "linux/bmac-dashboard.desktop"
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  }
}
