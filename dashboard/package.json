{
  "name": "bmac-dashboard",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "license": "GPL-3.0-only",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": "^24.0.0"
  },
  "scripts": {
    "check:toolchain": "node scripts/check-toolchain.mjs --app --verbose",
    "dev": "node scripts/check-toolchain.mjs && vite",
    "build": "node scripts/check-toolchain.mjs && pnpm web:build",
    "web:dev": "vite",
    "web:build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "tauri": "tauri",
    "app:dev": "node scripts/check-toolchain.mjs --app && tauri dev",
    "app:build": "node scripts/check-toolchain.mjs --app && tauri build",
    "app:build:appimage": "node scripts/check-toolchain.mjs --app && tauri build --bundles appimage",
    "app:build:rpm": "node scripts/check-toolchain.mjs --app && tauri build --bundles rpm"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/merge": "^6.12.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@lezer/highlight": "^1.2.5",
    "@radix-ui/react-checkbox": "^1.3.12",
    "@radix-ui/react-dialog": "^1.2.0",
    "@radix-ui/react-dropdown-menu": "^2.1.25",
    "@radix-ui/react-select": "^2.3.8",
    "@radix-ui/react-switch": "^1.3.8",
    "@radix-ui/react-tooltip": "^1.3.0",
    "@tauri-apps/api": "^2.12.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.52.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
