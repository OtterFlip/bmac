#
# BMAC's example todo app. Installed by
# scripts/user_callable/guests/prod/deploy_hello_app_to_prod.sh.

[Unit]
Description=BMAC example todo app (HTTPS on port 443)
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
ExecStart=/usr/local/bin/hello-todo --listen [::]:443 --cert %d/cert.pem --key %d/key.pem --db %S/hello-todo/todos.sqlite3
# The certificate and key stay root-only in /etc/hello-todo; systemd hands
# the service private copies.
LoadCredential=cert.pem:/etc/hello-todo/cert.pem
LoadCredential=key.pem:/etc/hello-todo/key.pem
StateDirectory=hello-todo
StateDirectoryMode=0700
DynamicUser=yes
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
UMask=0077
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
