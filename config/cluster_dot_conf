# Shared, non-secret configuration for the complete Proxmox cluster.
# This file is parsed as literal KEY=VALUE data; do not add shell commands.

# The key name and value must be separated by an '=' character with no
# additional space.  If the value contains spaces then enclose it in single-
# quotes, like so:
#   VALID_SYNTAX_EXAMPLE='This key value pair has valid syntax'
#   INVALID_SYNTAX_EXAMPLE = This key value pair has invalid syntax

# For most deployments, the only values you absolutely must change are these.
# They're used to define the subnet of the private VLAN between your cluster hosts.
# If you can use subnet 10.213.0.0/24 on your VLAN then most can stay as-is.
# You can also tweak the CPU/RAM/Storage value defaults but they can be overridden
# so they're not essential. The start-end ranges must fall within your VLAN's subnet.
#   PRIVATE_SUBNET_CIDR, PROXMOX_PRIVATE_BRIDGE, PROXMOX_MIGRATION_NETWORK
#   DATACENTER_PRIVATE_VLAN_GATEWAY, GUEST_GATEWAY_IP, GUEST_GATEWAY_MAC
#   MOX_IP_START, MOX_IP_END, MOX_REPLICATION_IP_START, MOX_REPLICATION_IP_END
#   VM_SLOT_START, MAX_PROD_VMS, MAX_STAGING_VMS_PER_PROD, PROXMOX_ADMIN_EMAIL
#   CLOUDFLARE_ACCOUNT_ID, CLOUDFLARE_TUNNEL_ID
#   PROXMOX_ISO_FILE_URL, PROXMOX_ISO_FILE_SHA256, PROD_GUEST_OS_ISO_URL, PROD_GUEST_OS_ISO_SHA256
#   ADMIN_1_PUBLIC_SSH_KEY, ADMIN_2_PUBLIC_SSH_KEY

# Cluster membership supports mox1 through mox10. The control node below
# (normally mox1) creates the cluster; later hosts join it. Slots freed by
# removing or purging a host are reused, lowest number first. The external
# QDevice contributes quorum only and is never a Cloudflare Tunnel replica,
# storage node, or guest egress path.
PROXMOX_CLUSTER_NAME=mycluster
PROXMOX_QDEVICE_HOST=qdevice

# Optional join/control node: new hosts join through it and it hosts the
# cluster control-plane lock. Before a cluster exists, the host named here
# creates it. Once the cluster exists, its registry records the authoritative
# control node, and setup/remove/purge stop if this value disagrees. If it is
# missing, those scripts prompt for it (default: the lowest-numbered reachable
# cluster member, or mox1 when no cluster exists yet). Removing or purging
# the control node selects a new one and offers to update this line.
PROXMOX_CONTROL_NODE=mox1

# Private host identity only; never publish this suffix in application DNS.
# add_proxmox_host.sh derives moxN.pve.internal and pins every slot to the
# corresponding private-VLAN address in each mox host's /etc/hosts.
# The reason MAX_MOX_HOSTS default is 10 is only because our default VLAN
# subnet is a /24 subnet and so only around 10 hosts and their guests fit.
# If you use a larger VLAN then you could easily increase MAX_MOX_HOSTS.
# However I believe many of the scripts are hard-coded to use slots 1-10
# for these hosts, rather than respecting this MAX_MOX_HOSTS value, so
# code will need to change if you modify MAX_MOX_HOSTS.  I'll remove this
# comment once I've refactored all the code so that nothing hard-codes only
# 10 Proxmox hosts. Keep in mind that if you decomission a host, then its slot
# becomes available to be reused by a new host.
PROXMOX_INTERNAL_DOMAIN=pve.internal
MAX_MOX_HOSTS=10

# IMPORTANT: Treat this entire private-network and address-allocation block as
# immutable after the first mox host is installed. Changing this file does not
# automatically renumber or fully reconcile existing hosts, guests, Corosync
# links, shared-gateway/nftables rules, the Cloudflare Tunnel configuration,
# /etc/hosts entries, or the persisted app-ha registry policy. A partial change
# can break cluster quorum, migration, ingress, guest egress, or management
# access. The VM slot keys (VM_SLOT_START, MAX_PROD_VMS,
# MAX_STAGING_VMS_PER_PROD) are the exception: after editing them, push them
# to every mox host with the dashboard's "Sync cluster with cluster.conf"
# operation. Never move a slot that a VM is using.
#
# If renumbering is unavoidable, first stop application traffic and take
# verified backups. Inventory every installed address and the registry policy,
# then update all hosts and guests as one coordinated maintenance operation.
# Existing mox bridge addresses, Corosync links, migration/replication network,
# managed /etc/hosts blocks, shared-gateway/nftables rules, the tunnel
# configuration, production/staging guest network configuration, and registry
# state must all agree before traffic resumes. For a small or
# not-yet-production cluster, a clean reinstall/recreation from the new
# configuration is safer than manual in-place patching. Do not merely rerun host setup and assume it migrated
# existing state; verify each subsystem explicitly through a console-capable
# maintenance path such as iDRAC.
#
# Shared private Layer-2 VLAN. Every mox host, production guest, and staging
# guest has one address on this /24. Each mox host also has exactly one
# address in the narrower .240/28 transport subnet on the same bridge. Proxmox
# uses only that narrower CIDR for migration and replication, so the ordinary
# host address and the shared guest gateway never create an ambiguous
# transport endpoint.
# WARNING: Make sure that none of the addresses in MOX_IP_START - MOX_IP_END
# or in the VM slots fall within the subnet you specify for
# PROXMOX_MIGRATION_NETWORK.
PRIVATE_SUBNET_CIDR=10.213.0.0/24
PROXMOX_PRIVATE_BRIDGE=vmbr-private
PROXMOX_MIGRATION_NETWORK=10.213.0.240/28

# FiberState currently reserves this address as the VLAN gateway. It is not
# functional for Internet egress and no script installs it as a default route;
# recording it prevents allocation and leaves room for future routed VLANs.
DATACENTER_PRIVATE_VLAN_GATEWAY=10.213.0.1

# Internet egress:
# Production and staging guests use GUEST_GATEWAY_IP as their only default
# gateway. Every mox host provides this same address, with this same MAC
# address, to the guests running on it; bridge rules on each mox host's
# private-VLAN port keep the address and MAC off the VLAN, so no other mox
# host ever sees them. Each mox host SNATs its own guests' traffic through
# its own public interface, and falls back to another mox host's internet
# connection when its own is down. Using the same MAC everywhere means a
# live-migrated guest keeps working without re-learning its gateway.
# GUEST_GATEWAY_MAC must be a locally administered unicast MAC (second hex
# digit 2, 6, A, or E) that nothing else on the VLAN uses.
GUEST_GATEWAY_IP=10.213.0.10
GUEST_GATEWAY_MAC=02:00:0a:d5:00:0a

# Address allocation. moxN is assigned sequentially from MOX_IP_START. All
# ranges and singleton roles must be non-overlapping.
MOX_IP_START=10.213.0.11
MOX_IP_END=10.213.0.20
MOX_REPLICATION_IP_START=10.213.0.241
MOX_REPLICATION_IP_END=10.213.0.250

# VM slots. Every production and staging guest has a fixed address, reserved
# in advance whether or not the guest exists, so creating or removing a
# staging guest never changes any network or Cloudflare configuration:
#   prodN       = VM_SLOT_START + 10*(N-1)   (prod1 .110, prod2 .120, ...)
#   stageKprodN = prodN's address + K        (stage1prod1 .111 ... .119)
# VM_SLOT_START's last octet must end in 0. MAX_PROD_VMS is 1-10 and
# MAX_STAGING_VMS_PER_PROD is 1-9. Every mox host's
# MAX_STAGING_VM_COUNT_ON_THIS_HOST must be no more than
# MAX_STAGING_VMS_PER_PROD. With the values below the slots are
# 10.213.0.110-10.213.0.209.
VM_SLOT_START=10.213.0.110
MAX_PROD_VMS=10
MAX_STAGING_VMS_PER_PROD=9

# Generic resource tags used by Proxmox configuration and lifecycle guards.
PRODUCTION_VM_TAG=app-ha-production
STAGING_VM_TAG=app-ha-staging
EVICTABLE_VM_TAG=app-ha-evictable
PURPOSE_TAG_PREFIX=purpose-
GUEST_ROLE_HOOK_PATH=local:snippets/app-ha-guest-role-hook.sh

# Root-only cluster registry replicated by pmxcfs.
# This is a directory on the Proxmox hosts
CLUSTER_STATE_DIR=/etc/pve/priv/app-ha

# Public ingress:
# One Cloudflare Tunnel serves the whole cluster, and every mox host runs a
# cloudflared replica of it. No mox host accepts inbound web traffic on its
# public IP. Each replica forwards every FQDN of every production guest and
# its staging slots to the slot's address over the private VLAN, so any mox
# host with a working internet connection can carry any guest's traffic.
# Create the tunnel once with `cloudflared tunnel login` and
# `cloudflared tunnel create <name>` (see README.md). The account ID and
# tunnel ID are in the credentials file it writes; the tunnel secret goes in
# secrets.env as CLOUDFLARE_TUNNEL_SECRET. Replace these example values.
CLOUDFLARE_ACCOUNT_ID=0123456789abcdef0123456789abcdef
CLOUDFLARE_TUNNEL_ID=00000000-0000-0000-0000-000000000000

# Defaults for newly-created production VMs. The creator prompts for overrides.
PROD_VM_CORES=64
PROD_VM_MEMORY_GIB=74
PROD_VM_DISK_GB=1024
PROD_VM_STORAGE=local-zfs
PROD_VM_BRIDGE=vmbr-private
PROD_VM_CPU_TYPE=x86-64-v2-AES
PROD_VM_REPLICATION_INTERVAL=*/15

# Staging clones inherit source disk size but may use smaller compute defaults.
STAGING_VM_CORES=10
STAGING_VM_MEMORY_GIB=16
STAGING_VM_STORAGE=local-zfs
STAGING_VM_BRIDGE=vmbr-private

# Storage IDs must have the same meaning on every HA-eligible mox host.
VM_STORAGE_ID=local-zfs
ZFS_STORAGE_ID=local-zfs
ISO_STORAGE_ID=local
SNIPPETS_STORAGE_ID=local

# Vanilla media. Scripts verify these files before generating automated ISOs.
PROXMOX_ISO_FILE_URL=https://enterprise.proxmox.com/iso/proxmox-ve_9.2-1.iso
PROXMOX_ISO_FILE_SHA256=4e88fe416df9b527624a175f24c9aa07c714d3332afb1ee3dbf3879573ef2c6c
PROD_GUEST_OS_ISO_URL=https://releases.ubuntu.com/26.04.1/ubuntu-26.04.1-live-server-amd64.iso
PROD_GUEST_OS_ISO_SHA256=cc8a95cde20f6ced61a322420de00f10cc3c90ced545daa46cb9c1a117f1d927
# PROD_GUEST_OS_INSTALL_MODE is optional; defaults to ubuntu-autoinstall. Other supported value: manual.
# If PROD_GUEST_OS_INSTALL_MODE is missing then the default value 'ubuntu-autoinstall' will be used
# Use manual for non-Ubuntu OS ISOs.  Prod setup script will then provide additional instructions for manual setup of such an OS.
# Use ubuntu-autoinstall for any Ubuntu server ISO, generally.
PROD_GUEST_OS_INSTALL_MODE=ubuntu-autoinstall

# Guest networking is static and registry-backed; no DHCP service is needed.
PROXMOX_DNS_SERVER=1.1.1.1
GUEST_DNS_SERVERS=1.1.1.1,1.0.0.1

PROXMOX_ADMIN_EMAIL=admin@example.com
PROXMOX_TIMEZONE=America/Denver
PROXMOX_COUNTRY=us
PROXMOX_KEYBOARD=en-us

# Tailscale is installed only on mox hosts and qdevice. Guests are reached by
# SSH ProxyJump through any reachable mox host.
TAILSCALE_TAG=tag:proxmox-host
MOX_SSH_USER=root
MOX_SSH_CONNECT_TIMEOUT=8
GUEST_SSH_USER=root

# Public keys injected into every mox host and automated Ubuntu guest. Guest
# root SSH is key-only; the root password in secrets.env is console-only.
ADMIN_1_PUBLIC_SSH_KEY='ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIBhE1+iRU5AP8b2hmfLfAHJQ/BVRAR0n4ddx0DFCnkg4 admin1@example.com'
ADMIN_2_PUBLIC_SSH_KEY='ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIPIdG/s65LGj6TCZMI9gFwrAKAClmhr4871Cgidd9RNR admin2@example.com'

# Specifies if monitoring is to be setup for proxmox hosts, the qdevice and prod VMs
# When MONITORING_ENABLED=true, HEALTHCHECKS_API_KEY must be set in
# secrets.env and PROXMOX_QDEVICE_HOST must be set and reachable via ssh
MONITORING_ENABLED=true

# IPv4 address or domain of PBS server
PROXMOX_PBS_SERVER_HOST=1.2.3.4

# PBS server port (default, if missing, is 8007)
PROXMOX_PBS_SERVER_PORT=8007

# PBS server datastore
PROXMOX_PBS_DATASTORE=pbs

# This cluster's PBS namespace
PROXMOX_PBS_NAMESPACE=mycluster

# This cluster's PBS username
PROXMOX_PBS_USERNAME=mycluster@pbs!pve

# SHA-256 fingerprint of the PBS server's TLS certificate (port 8007).
# Get the known-good value ON the PBS server itself (not over the network):
#   CLI:  proxmox-backup-manager cert info | grep -i fingerprint
#   GUI:  PBS web UI -> Dashboard -> "Show Fingerprint"
# Use the colon-separated hex form, e.g. 5d:17:0f:...:07:8d (case-insensitive).
# This value changes if the PBS certificate is regenerated or replaced
# (e.g. a new self-signed cert or an ACME/Let's Encrypt cert); update it here if so.
PROXMOX_PBS_FINGERPRINT=00:11:22:33:44:55:66:77:88:99:aa:bb:cc:dd:ee:ff:00:11:22:33:44:55:66:77:88:99:aa:bb:cc:dd:ee:ff