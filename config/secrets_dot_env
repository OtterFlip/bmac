# Copy this example file to config/secrets.env (put the copy in the same directory), fill it in, and run:
#   chmod 600 config/secrets.env
# secrets.env is Git-ignored and is the only private configuration file used
# by these orchestration scripts.

# The key name and value must be separated by an '=' character with no
# additional space.  If the value contains spaces then enclose it in single-
# quotes, like so:
#   VALID_SYNTAX_EXAMPLE='This key value pair has valid syntax'
#   INVALID_SYNTAX_EXAMPLE = This key value pair has invalid syntax

# Optional. These are required only when add_proxmox_host.sh is run in
# iDRAC/Redfish inventory mode. Manual Live Linux inventory does not use them.
IDRAC_USER=redacted
IDRAC_PASSWORD=redacted

# All Proxmox hosts share the same root console password.
PROXMOX_ROOT_PASSWORD=redacted

# Production guests share this console password. SSH remains key-only.
PROD_GUEST_VM_ROOT_PASSWORD=redacted

# Staging guests share this console password. SSH remains key-only.
STAGING_GUEST_VM_ROOT_PASSWORD=redacted

# All of our Proxmox hosts use the same LUKS password for all of their encrypted disks
PROXMOX_LUKS_PASSWORD=redacted

# Our qdevice has its own root password
PROXMOX_QDEVICE_ROOT_PASSWORD=redacted

# The cluster's Cloudflare Tunnel secret: the "TunnelSecret" value from the
# credentials file that `cloudflared tunnel create` wrote, usually
# ~/.cloudflared/<CLOUDFLARE_TUNNEL_ID>.json. Host setup combines it with
# CLOUDFLARE_ACCOUNT_ID and CLOUDFLARE_TUNNEL_ID from cluster.conf to write
# the tunnel's credentials file on every mox host. Anyone holding it can run
# a replica of the tunnel and receive its traffic.
CLOUDFLARE_TUNNEL_SECRET=redacted

# Healthchecks.io project API key (read-write). Required when
# MONITORING_ENABLED=true in cluster.conf. Used only by the workstation to
# create, update, and delete this cluster's checks and to read their status.
# Nodes never receive it; each node receives only its own check's ping URL.
HEALTHCHECKS_API_KEY=redacted

# PBS server access token for this cluster (looks like a UUID value)
PROXMOX_PBS_TOKEN=redacted

